rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared helpers. Student C owns the overall skeleton; each student adds the
    // blocks and tests for their own collections. Deny by default: anything not
    // matched below is refused.
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function doc(path) { return /databases/$(database)/documents/$(path); }

    function optionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    // ── users/{uid} ─ public profile (B creates, A edits, C aggregates ratings) ──
    // Emails stay in Firebase Auth. The admin role is a custom claim, never a field.
    function validProfileFields(data) {
      return data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && optionalString(data, 'photoURL', 1000)
        && optionalString(data, 'faculty', 100)
        && optionalString(data, 'bio', 300);
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(
             ['username', 'displayName', 'photoURL', 'faculty', 'bio', 'ratingAvg', 'ratingCount', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'ratingAvg', 'ratingCount', 'createdAt'])
        && validProfileFields(request.resource.data)
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.createdAt == request.time
        // A username must be claimed in usernames/ in the same transaction.
        && (request.resource.data.get('username', null) == null
            || getAfter(doc('usernames/' + request.resource.data.username)).data.uid == uid);

      // UC-S3 (Student A): only profile fields; username, ratings and createdAt are fixed.
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'faculty', 'bio'])
        && validProfileFields(request.resource.data);

      allow delete: if false;
    }

    // ── usernames/{username} ─ uniqueness claims, written once at signup (B) ──
    match /usernames/{name} {
      allow get: if true;      // registration checks availability before sign-in
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // Only together with creating your own profile, so nobody hoards names.
        && !exists(doc('users/' + request.auth.uid))
        && getAfter(doc('users/' + request.auth.uid)).data.username == name;
      allow update, delete: if false;
    }
   
    // ── listings/{listingId} ─ Marketplace items (Student A) ──
    match /listings/{listingId} {
      allow read: if true;

      allow create: if isUser(request.resource.data.sellerId)
        && request.resource.data.status == 'active'
        && request.resource.data.flagCount == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.price is number
        && request.resource.data.price >= 0;

      // UC-A2: seller can edit whitelisted fields or mark as sold (never flagCount/boostedUntil)
      allow update: if isUser(resource.data.sellerId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'category', 'price', 'searchKeywords', 'status'])
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status == 'sold');

      allow delete: if isUser(resource.data.sellerId) || isAdmin();
    }
  }
}
